# Production image: build the Vite bundle, then serve it from nginx.
# Build context is the repo root so the shared workspace package is available:
#   docker build -f frontend/Dockerfile.prod -t lakasmarket-web .
# Bake the API URL at build time: --build-arg VITE_API_URL=https://api.example.com

# --- build stage ------------------------------------------------------------
FROM node:20-slim AS build
WORKDIR /repo

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY frontend/package.json frontend/package.json
RUN npm install

COPY . .

ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /repo/frontend
RUN npm run build

# --- serve stage ------------------------------------------------------------
FROM nginx:1.27-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/frontend/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
